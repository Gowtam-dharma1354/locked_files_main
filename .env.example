# Client (Vite) - safe to add to .env.example
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (do NOT add these to client or commit them in real .env files)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY must be set in Vercel environment variables for server functions
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
